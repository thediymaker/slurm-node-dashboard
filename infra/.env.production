# =============================================================================
# SLURM NODE DASHBOARD - PRODUCTION CONFIGURATION
# =============================================================================
#
# ⚠️  IMPORTANT: MOVE this file to .env, do NOT copy it!
#
#     mv .env.production .env
#
# If both .env.production and .env exist simultaneously, Next.js may pick up
# variables randomly from either file, causing strange and unpredictable
# behavior. Always ensure only ONE env file exists in production.
#
# Since 3.0 every setting here is read when the server starts, so changing one
# needs a restart, not a rebuild. The exception is NEXT_PUBLIC_BASE_PATH, which
# is fixed when the app is built.

# -----------------------------------------------------------------------------
# GENERAL SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV="production"
REACT_EDITOR="code"

# Cluster branding
COMPANY_NAME=""
CLUSTER_NAME=""
CLUSTER_LOGO="/logo.png"

# Support URL (optional - shown in the menu)
# Example: https://support.yourcompany.com
NEXT_PUBLIC_SUPPORT_URL=""

NODEVIEW_CONFIG_PATH=infra/node.cfg

# -----------------------------------------------------------------------------
# SLURM REST API CONNECTION
# -----------------------------------------------------------------------------
# Protocol: http or https
SLURM_PROTOCOL="http"

# Slurm REST API server hostname or IP (without protocol or port)
# Example: slurmrestd.example.com
SLURM_SERVER=""

# API version. Leave unset to use the newest version your slurmrestd serves.
# To pin one, pick from `slurmrestd -d list` (Slurm 26.05 serves v0.0.42-v0.0.45).
# SLURM_API_VERSION="v0.0.42"

# JWT token for authentication
SLURM_API_TOKEN=""

# Slurm user account for API requests
SLURM_API_ACCOUNT=""

# -----------------------------------------------------------------------------
# PROMETHEUS MONITORING (Optional)
# -----------------------------------------------------------------------------
# Full URL to your Prometheus server
# Example: http://prometheus.example.com:9090
# Example: https://prometheus.internal:9090
PROMETHEUS_URL=""

# Optional: large node cards show power, temperature, per-GPU busyness and the
# last hour of load from Prometheus; the temperature turns yellow at this (°C)
# NODE_TEMP_WARN_C="80"

# Optional: scope GPU metrics to one cluster when a shared Prometheus scrapes
# multiple Slurm clusters. Requires DCGM metrics/recording rules to include a
# matching `cluster` label.
# Example: dev
GPU_METRICS_CLUSTER=""

# Advanced: raw PromQL label matcher(s) applied to GPU Prometheus queries.
# Overrides GPU_METRICS_CLUSTER when set.
# Example: cluster="dev"
# Example: instance=~".*\\.sol\\.rc\\.asu\\.edu"
GPU_METRICS_LABEL_FILTER=""

# Advanced: capture-only PromQL label matcher(s). Overrides the global GPU
# metrics filter for POST /api/gpu snapshot writes.
# Example: cluster="dev"
GPU_METRICS_CAPTURE_LABEL_FILTER=""

# Optional: require a secret for POST /api/gpu capture requests.
# Requests must send Authorization: Bearer <token> or x-api-key: <token>.
GPU_METRICS_CAPTURE_TOKEN=""

# -----------------------------------------------------------------------------
# SLACK NOTIFICATIONS (Optional)
# -----------------------------------------------------------------------------
# Webhook URL for Slack notifications (token expiry alerts)
# Create an incoming webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=""

# Number of days before token expiry to start sending warnings (default: 30)
# Alerts will be sent daily when token expires within this threshold
SLURM_TOKEN_EXPIRY_WARNING_DAYS="30"

# -----------------------------------------------------------------------------
# AI ASSISTANT (Optional)
# -----------------------------------------------------------------------------
# OpenAI API key for the AI chat assistant
OPENAI_API_KEY=""

# API endpoint (use default for OpenAI, or custom for Azure/local models)
# Example: https://api.openai.com/v1
# Example: https://your-resource.openai.azure.com/openai/deployments/your-deployment
OPENAI_API_URL="https://api.openai.com/v1"

# Model to use for chat completions
# Example: gpt-4o-mini, gpt-4o, gpt-4-turbo
OPENAI_API_MODEL="gpt-4o-mini"

# Model to use for suggested prompts (can be a smaller/cheaper model)
# Example: gpt-4o-mini, gpt-3.5-turbo
OPENAI_API_MODEL_SUGGESTION="gpt-4o-mini"

# -----------------------------------------------------------------------------
# ADMIN AUTHENTICATION
# -----------------------------------------------------------------------------
# Credentials for the /admin dashboard
# Long random string that signs admin sessions; login fails without it.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password"

# -----------------------------------------------------------------------------
# OPTIONAL FEATURES
# -----------------------------------------------------------------------------
# Features turn on by themselves when what they need is configured. The admin
# page's Plugins tab shows each one's state and why. Set a flag to "false" to
# turn a feature off.
#
# Without a database:
#   Modules (/modules)          - public/modules.json, or MODULES_FILE
#   Prometheus node charts      - PROMETHEUS_URL
#   GPU utilization             - PROMETHEUS_URL with DCGM metrics, and
#                                 NEXT_PUBLIC_ENABLE_GPU_UTILIZATION="true"
#   AI assistant                - NEXT_PUBLIC_ENABLE_OPENAI_PLUGIN="true"
# With a database (DATABASE_URL below):
#   Rewind (/rewind)            - hourly cluster snapshots
#   Node history                - each node's states (full, partial, idle, drained,
#                                 down...) over time, and drain/down reasons
#   GPU history                 - also needs GPU utilization
#   Job metrics (/metrics)      - also needs slurm-history-ingestor
# NEXT_PUBLIC_ENABLE_MODULES_PLUGIN="false"
# NEXT_PUBLIC_ENABLE_HISTORY_PLUGIN="false"
# NEXT_PUBLIC_ENABLE_JOB_METRICS_PLUGIN="false"
# ENABLE_NODE_HISTORY="false"
# GPU_METRICS_HISTORY="false"
NEXT_PUBLIC_ENABLE_GPU_UTILIZATION="false"
NEXT_PUBLIC_ENABLE_OPENAI_PLUGIN="false"

# Path to the Lmod spider JSON for the Modules page (default: public/modules.json).
# infra/modules.example.json shows the format.
# MODULES_FILE="/etc/slurm-dashboard/modules.json"

# -----------------------------------------------------------------------------
# DATABASE (Optional)
# -----------------------------------------------------------------------------
# PostgreSQL for Rewind, node history, GPU history and job metrics. The
# dashboard creates the tables it needs on startup, so the user needs CREATE
# permission on the database the first time. slurm-history-ingestor can use the
# same database for job metrics.
# Format: postgresql://username:password@hostname:port/database
# Before 3.0 this was SLURM_JOB_METRICS_DATABASE_URL, which still works.
DATABASE_URL=""

# Seconds to wait for a database connection (default 5)
# DATABASE_CONNECT_TIMEOUT_MS="5000"

# Background collection (seconds/minutes/days; 0 turns one off)
# NODE_HISTORY_INTERVAL_SECONDS="60"
# NODE_HISTORY_RETENTION_DAYS="30"
# SNAPSHOT_INTERVAL_MINUTES="60"
# SNAPSHOT_RETENTION_DAYS="30"
# GPU_CAPTURE_INTERVAL_SECONDS="60"

# Hierarchy labels (customize for your organization)
# These labels appear in the metrics dashboard filters and charts
NEXT_PUBLIC_HIERARCHY_LEVEL_1_LABEL="College"
NEXT_PUBLIC_HIERARCHY_LEVEL_2_LABEL="Department"
